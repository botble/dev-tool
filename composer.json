{
  "name": "tiryaq/dev-tool",
  "description": "Dev tool commands for Tiryaq CMS",
  "type": "package",
  "license": "MIT",
  "keywords": [
    "tiryaq",
    "tiryaq cms",
    "tiryaq platform",
    "tiryaq dev tools"
  ],
  "homepage": "https://tiryaq.co",
  "authors": [
    {
      "name": "tiryaq Technologies",
      "email": "contact@tiryaq.co"
    }
  ],
  "autoload": {
    "psr-4": {
      "Tiryaq\\DevTool\\": "src"
    }
  },
  "require": {
    "laravel/framework": "^10.31|^11.0|^12.0"
  },
  "require-dev": {
    "laravel/pint": "^1.5.0",
    "phpunit/phpunit": "^9.0|^10.0|^11.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Tiryaq\\DevTool\\Providers\\DevToolServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
